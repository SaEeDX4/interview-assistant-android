<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- P5 live audio: capture runs only inside the microphone-typed foreground service;
         permissions are requested at a capture start, never at app start. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- P6: Google Play Billing (OD-1) and the D12 battery-optimisation exemption flow
         (the direct ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS intent; P6-PORT-NOTES DC-188). -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".InterviewAssistantApplication"
        android:allowBackup="true"
        android:label="Interview Assistant"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- OAuth redirect surface (§8 D5): the custom-scheme fallback for the Windows loopback
                 listener. The verified-https App Link filter is added when the operator's redirect
                 host is pinned (see P2-PORT-NOTES.md); the shared RedirectUriParser enforces the
                 /callback path + PKCE state on either surface. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="interviewassistant"
                    android:host="oauth"
                    android:path="/callback" />
            </intent-filter>
        </activity>
        <!-- The P5 foreground service (TRANSFER-MAP §6.2 audio row, §8 D12): keeps capture and
             the live session alive under the persistent notification whose actions are the D2
             shortcut surface. The mediaProjection type is asserted only while playback capture
             runs; the service is started with the types the current capture actually uses. -->
        <service
            android:name=".platform.CaptureForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection" />
        <!-- Sharing the app's own files with viewer apps (report copies, the log folder) goes
             through a FileProvider; no other app gets a raw file path (P4-E shell wiring). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
